---
import '../styles/global.css';
import '../styles/dashboard.css';
import '../styles/intro.css';
import { rooms, sections } from '../data/rooms';
import RoomShowcase from '../components/RoomShowcase.tsx';
import Billboard from '../components/Billboard.tsx';
import IntroSequence from '../components/IntroSequence.tsx';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

// Canonical home is the GitHub Pages deployment (matches `site` in astro.config).
// Absolute URLs here so social/link previews resolve regardless of which host
// serves the HTML (Pages or Vercel).
const SITE = 'https://daniel-lamb.github.io/Escape-Room';
const pageUrl = `${SITE}/`;
const ogImage = `${SITE}/og-cover.webp`;
const ogDescription =
  'A collection of hour-long browser escape rooms — solo, two-player, and group. Hand-built, fair, and playable start to finish. Pick your door; Gus will meet you inside.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Escape Rooms — Choose Your Door</title>
    <meta name="description" content={ogDescription} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0a0b10" />
    <meta name="color-scheme" content="dark" />

    <!-- Opening cinematic gate. Set pre-paint so the dashboard beneath the
         intro overlay never flashes, and so returning visitors this session
         skip straight to it. The client-only IntroSequence island takes over. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          d.setAttribute(
            'data-intro',
            sessionStorage.getItem('escape-intro-seen') === '1' ? 'seen' : 'play',
          );
        } catch (e) {
          d.setAttribute('data-intro', 'play');
        }
        // Don't strand the dashboard hidden if the island never mounts.
        setTimeout(function () {
          if (d.getAttribute('data-intro') === 'play' && !window.__introMounted) {
            d.setAttribute('data-intro', 'seen');
          }
        }, 3000);
      })();
    </script>

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Escape Rooms" />
    <meta property="og:title" content="Escape Rooms — Choose Your Door" />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="671" />
    <meta property="og:image:alt" content="Torch-lit hypogeum beneath the Colosseum" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Escape Rooms — Choose Your Door" />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="intro-mount"><IntroSequence client:only="react" /></div>

    <div class="bg"></div>

    <header class="nav">
      <a class="nav-brand" href={base}>Escape Rooms</a>
      <nav class="nav-links">
        <a href="#rooms">Browse</a>
        <a href="https://github.com/Daniel-Lamb/Escape-Room">GitHub</a>
      </nav>
    </header>

    <Billboard client:load />

    <main id="rooms" class="rows">
      <RoomShowcase client:load />
    </main>

    <footer class="site-footer">
      <div class="foot-inner">
        <div class="foot-brand">
          <a class="foot-word" href={base}>Escape Rooms</a>
          <p class="foot-tagline">
            Hour-long escape rooms that run right in your browser — solo,
            two-player, and group. Every one is hand-built, fair, and playable
            start to finish.
          </p>
          <ul class="foot-facts">
            <li>Free to play</li>
            <li>No sign-up</li>
            <li>Plays in your browser</li>
            <li>Progress saved on your device</li>
          </ul>
        </div>

        {
          sections.map((sec) => (
            <nav class="foot-col" aria-label={sec.title}>
              <h3>{sec.title}</h3>
              <ul>
                {rooms
                  .filter((r) => r.mode === sec.mode && r.status === 'live')
                  .map((r) => (
                    <li>
                      <a href={r.href}>{r.title}</a>
                    </li>
                  ))}
                {rooms.some((r) => r.mode === sec.mode && r.status === 'concept') && (
                  <li class="foot-soon">More soon</li>
                )}
              </ul>
            </nav>
          ))
        }
      </div>

      <div class="foot-bar">
        <span>&copy; {year} Daniel Lamb</span>
        <span class="foot-sep">&middot;</span>
        <a href="https://github.com/Daniel-Lamb/Escape-Room">Source on GitHub</a>
        <span class="foot-sep">&middot;</span>
        <span class="foot-note">Open source &middot; zero dependencies &middot; built with Astro</span>
      </div>
    </footer>
  </body>
</html>
