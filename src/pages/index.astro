---
import '../styles/global.css';
import '../styles/dashboard.css';
import { liveRooms, rooms } from '../data/rooms';
import RoomShowcase from '../components/RoomShowcase.tsx';

const covers = import.meta.glob('../covers/*.webp', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
const cover = (art: string) => covers[`../covers/${art}.webp`];

const base = import.meta.env.BASE_URL;
const roomsLive = liveRooms.length;
const puzzles = roomsLive * 7;

// The featured "billboard" room — the torch-lit Colosseum cover sets the warm,
// amber-gold tone the whole dashboard is keyed to.
const featured = rooms.find((r) => r.id === 'gate-of-life') ?? liveRooms[0];

// Canonical home is the GitHub Pages deployment (matches `site` in astro.config).
// Absolute URLs here so social/link previews resolve regardless of which host
// serves the HTML (Pages or Vercel).
const SITE = 'https://daniel-lamb.github.io/Escape-Room';
const pageUrl = `${SITE}/`;
const ogImage = `${SITE}/og-cover.webp`;
const ogDescription =
  'A collection of hour-long browser escape rooms — solo, two-player, and group. Hand-built, fair, and playable start to finish. Pick your door; Gus will meet you inside.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Escape Rooms — Choose Your Door</title>
    <meta name="description" content={ogDescription} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0a0b10" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Escape Rooms" />
    <meta property="og:title" content="Escape Rooms — Choose Your Door" />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="671" />
    <meta property="og:image:alt" content="Torch-lit hypogeum beneath the Colosseum" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Escape Rooms — Choose Your Door" />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="bg"></div>

    <header class="nav">
      <a class="nav-brand" href={base}>Escape Rooms</a>
      <nav class="nav-links">
        <a href="#rooms">Browse</a>
        <a href="https://github.com/Daniel-Lamb/Escape-Room">GitHub</a>
      </nav>
    </header>

    <section class="billboard">
      <img class="billboard-img" src={cover(featured.art)} alt="" />
      <div class="billboard-scrim"></div>
      <div class="billboard-content">
        <p class="billboard-kicker">Featured &middot; {featured.kicker}</p>
        <h1 class="billboard-title">{featured.title}</h1>
        <div class="billboard-meta">
          <span class="badge-live">&#9679; Live</span>
          <span>{roomsLive} rooms</span><span class="dot">&middot;</span>
          <span>{puzzles} puzzles</span><span class="dot">&middot;</span>
          <span>~60 min each</span>
        </div>
        <p class="billboard-blurb">{featured.blurb}</p>
        <div class="billboard-actions">
          <a class="btn-play" href={featured.href}>&#9654;&nbsp; {featured.cta ?? 'Enter'}</a>
          <a class="btn-info" href="#rooms">&#9776;&nbsp; Browse all rooms</a>
        </div>
      </div>
    </section>

    <main id="rooms" class="rows">
      <RoomShowcase client:load />
    </main>

    <footer>
      One companion across every era &middot;
      <a href="https://github.com/Daniel-Lamb/Escape-Room">source on GitHub</a>
    </footer>
  </body>
</html>
